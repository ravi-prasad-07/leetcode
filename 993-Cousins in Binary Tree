/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Solution {
public:
    bool isCousins(TreeNode* root, int x, int y) {
        queue<TreeNode*> q;
        q.push(root);

        while(!q.empty()){
            int test=0;
            int n=q.size();

            for(int i=0;i<n;i++){
                TreeNode* temp=q.front();
                q.pop();

                if(temp->val==x || temp->val==y){
                    test++;
                }

                if(temp->left && temp->right){
                    if((temp->left->val == x && temp->right->val == y) ||
                       (temp->left->val == y && temp->right->val == x)){
                        return false;
                    }
                }

                if(temp->left) q.push(temp->left);
                if(temp->right) q.push(temp->right);
            }

            if(test==2) return true;
            if(test==1) return false;
        }

        return false;
    }
};


/*
Intuition
Two nodes in a binary tree are called cousins if:

They are at the same depth, and
They have different parents
To check this efficiently, we can traverse the tree level by level (BFS), since each level represents nodes at the same depth.

Approach

Use a queue to perform level-order traversal (BFS)

For each level:

Initialize a counter test = 0 to track how many of x and y are found

Traverse all nodes in the current level:

If a node’s value is x or y, increment test

Check if the current node has both left and right children:

If one child is x and the other is y, they share the same parent → return false
Push left and right children into the queue if they exist

After processing the level:

If test == 2, both nodes are found at the same level → return true
If test == 1, only one node is found → return false
Time Complexity

O(n)
Each node is visited exactly once during BFS traversal
Space Complexity

O(n)
In the worst case, the queue stores all nodes at the last level
Key Points

BFS ensures nodes are checked level by level (same depth)
Sibling check prevents nodes with the same parent from being considered cousins
Early stopping avoids unnecessary traversal
*/
